<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Background color of the CardView -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/card_color" /> <!-- Solid color of the card -->
        </shape>
    </item>

    <!-- Stroke of the CardView -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="3dp"
                android:color="@color/bg_color" /> <!-- Stroke width and color -->
            <corners android:radius="15dp" /> <!-- Adjust corner radius as needed -->
        </shape>
    </item>
</layer-list>

